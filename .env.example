# .env — local dev configuration for rag-pipeline.
# Dev only: copy to .env and fill in values.
# Prod (K8s): secrets come from Kubernetes Secrets (see k8s/base/secrets.yaml);
# non-secret tunables come from config/config.prod.json baked into the image.
# Single-quote all values — bash mangles `&`, `;`, `!`, `$` on source.

# ── Runtime env ──────────────────────────────────────────────────────────────
# RAG_ENV is unset or "dev" for local Compose/laptop, "prod" on K8s.
RAG_ENV=dev

# ── LLM provider keys (the pipeline is pluggable; set the one you use) ───────
# OpenRouter (OpenAI-API-compatible) — current default for chat/QA + doc parsing.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── LLM / embedding defaults (JSON config wins on prod) ──────────────────────
# Embeddings run locally via Ollama (mxbai-embed-large) by default.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=mxbai-embed-large
# Use http://localhost:11434 for a bare-metal run; under Docker Compose on
# Docker Desktop use http://host.docker.internal:11434 to reach host Ollama.
OLLAMA_BASE_URL=http://localhost:11434

# Chat/QA answer synthesis (OpenRouter free tier).
LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ── Document parsing (config-driven — see docs/adr/0002-document-parsing.md) ──
# PARSER_PROVIDER selects the PDF text-extraction backend:
#   openrouter            → vision LLM over rendered page images via OpenRouter (default)
#   openai | anthropic    → vision LLM over rendered page images
#   ocr                  → Tesseract (scanned PDFs, no LLM cost)
# DOCX is handled by docling → markdown.
PDF_DPI=300
OCR_LANG=eng
TESSERACT_CMD=
# PDF_TEXT_SOURCE: auto (use the PDF's text layer per page, OCR/vision only for scanned pages) | native | image
PDF_TEXT_SOURCE=auto
PARSER_PROVIDER=openrouter
PARSER_LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
PARSER_SYSTEM_PROMPT=Extract all text from this document page verbatim, preserving layout as much as possible. Output plain text only — no commentary.
PARSER_TIMEOUT_SECONDS=60.0
DOCX_READER=docling

# ── Postgres (pgvector) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── ChromaDB (server mode) ───────────────────────────────────────────────────
# Embedded Chroma is the zero-dependency default; set these to use the
# chroma service from docker-compose or a remote deployment.
VECTOR_STORE=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
# CHROMA_AUTHN_CREDENTIALS=
# CHROMA_COLLECTION=documents
# Vector store options (docs/configuration.md). Leave them unset for the default (Chroma, l2, HNSW as Chroma
# builds it). Changing store/metric/index/dimension on existing data needs `python -m app.manage reindex`.
# VECTOR_STORE=pgvector            # chroma | pgvector (pgvector keeps vectors in the app's Postgres)
# VECTOR_METRIC=cosine             # cosine | l2 | ip   (unset: l2 on Chroma, cosine on pgvector)
# VECTOR_INDEX=hnsw                # hnsw | ivfflat | none (Chroma: hnsw only)
# HNSW_M=16
# HNSW_EF_CONSTRUCTION=64
# HNSW_EF_SEARCH=40                # query-time
# IVFFLAT_LISTS=100
# IVFFLAT_PROBES=10                # query-time
# EMBEDDING_DIMENSION=1024         # pgvector column width; unset = looked up from EMBEDDING_MODEL

# ── Dashboard / secrets ──────────────────────────────────────────────────────
# JWT signing key. Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Required (>= 32 chars, not a placeholder) when RAG_ENV is not dev.
SECRET_KEY=change-me
# Authentication + RBAC. AUTH_ENABLED=false treats every request as an admin (demos only).
AUTH_ENABLED=true
# First-run bootstrap admin: created only when the users table is empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# ── App tunables ─────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
# Index-time (changing these re-chunks and re-embeds every document on its next ingest):
# CHUNK_SIZE = hard max chunk length in chars; CHUNK_OVERLAP = MIN chunk length (nothing is repeated).
# Chunks are cut at word starts, preferably sentence ends. See docs/configuration.md.
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
DEFAULT_TOP_K=5
# Query-time: also give the LLM the N chunks before/after each hit (0 = hits only, max 5).
RETRIEVAL_NEIGHBORS=1
# Query-time retrieval strategy (per-request `mode`/`fusion` on POST /chat; see docs/configuration.md#retrieval-modes).
# RETRIEVAL_MODE=semantic                 # semantic | keyword | hybrid
# RETRIEVAL_KEYWORD_METHOD=bm25           # bm25 | postgres_fts
# RETRIEVAL_FUSION=rrf                    # rrf | weighted (hybrid only)
# RETRIEVAL_RRF_K=60
# RETRIEVAL_WEIGHT_SEMANTIC=0.6           # weighted fusion; normalised to sum 1
# RETRIEVAL_WEIGHT_KEYWORD=0.4
# RETRIEVAL_CANDIDATES=50                 # per-retriever pool before fusion / top_k
# RETRIEVAL_KEYWORD_POOL=200              # FTS matches re-scored with BM25
# BM25_K1=1.2
# BM25_B=0.75
# RETRIEVAL_FTS_CONFIG=english            # Postgres text-search config; change => `python -m app.manage rebuild-fts`
# RETRIEVAL_DEDUPE=true
MAX_UPLOAD_SIZE_BYTES=26214400

# ── File storage + ingest from links (docs/configuration.md#file-storage-and-url-ingest) ──────────────
# STORAGE_BACKEND=local                   # local (DATA_DIR, default) | s3 (S3-compatible: AWS S3, MinIO, ...)
# S3_ENDPOINT_URL=http://localhost:9000   # empty = AWS. Compose `s3` profile (MinIO): localhost:9000 from the host;
#                                         # containers must use http://minio:9000 (set S3_ENDPOINT_URL_DOCKER)
# S3_BUCKET=rag-documents
# S3_REGION=us-east-1
# S3_PREFIX=rag-pipeline/                 # the app only ever lists/deletes keys under this prefix
# S3_ACCESS_KEY_ID='minioadmin'           # secrets (K8s Secret in prod); MinIO dev default shown
# S3_SECRET_ACCESS_KEY='minioadmin'
# URL_INGEST_SCHEMES=http,https,s3        # POST /documents/from-url scheme allow-list
# URL_INGEST_S3_BUCKETS=                  # buckets s3:// links may read; empty = only S3_BUCKET
# URL_INGEST_ALLOW_PRIVATE=false          # NEVER true in production: lifts the SSRF address block (tests/smoke only)
# URL_INGEST_TIMEOUT_SECONDS=20
# URL_INGEST_TOTAL_TIMEOUT_SECONDS=120
# URL_INGEST_MAX_REDIRECTS=5
# URL_INGEST_MAX_BYTES=                   # empty = MAX_UPLOAD_SIZE_BYTES
