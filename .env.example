# Minimal .env for a bare-bones install. Copy to .env and fill the four blanks below.
#   cp .env.example .env
# Single-quote values that contain & ; ! $ (bash mangles them on `source`).
#
# Everything else (LLM and embedding providers, API keys, models, retrieval, cache, parser, storage) is
# configured in the dashboard after you log in: Admin > Settings. Environment variables WIN over the UI:
# a key that is present here is locked in Admin > Settings. Leave a key out of this file to keep it editable
# in the UI. The full list of tunables is in .env.reference and docs/configuration.md.

# -- Secrets (generate both) --------------------------------------------------
# JWT signing key.   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
# Encrypts provider keys you save from Admin > Settings (write-only, stored encrypted in the database).
# Without it the Settings window works but secret fields stay disabled. Same generation command.
SETTINGS_ENCRYPTION_KEY=

# -- First-run admin ----------------------------------------------------------
# Created only while the users table is empty. Change the password after the first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# -- Infrastructure URLs ------------------------------------------------------
# These localhost values suit a host-run API (make run). Docker Compose overrides them with its own
# service hostnames, so you normally do not change them.
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CHROMA_HOST=localhost
CHROMA_PORT=8001
