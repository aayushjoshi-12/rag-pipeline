# Production image: static build served by nginx, /api proxied to the backend service.
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# Unprivileged nginx (non-root master and workers, listens on 8080). Tag follows the stable 1.30 line; bump it when Trivy
# reports fixable OS CVEs in the base.
FROM nginxinc/nginx-unprivileged:1.31-alpine
# Pull in the Alpine security fixes published since the base image was built (the release gate fails on fixable CRITICALs).
USER root
RUN apk upgrade --no-cache
USER nginx
# API_UPSTREAM is substituted into the template at container start (nginx image feature).
ENV API_UPSTREAM=http://rag-pipeline-api:8000
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
# Optional HTTPS: only active when TLS_CERT_FILE / TLS_KEY_FILE are set (listens on 8443 in addition to 8080).
COPY --chmod=755 30-enable-tls.sh /docker-entrypoint.d/30-enable-tls.sh
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080 8443
